#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap{
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &kp ESCAPE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp INSERT &kp DELETE &mo 1 &studio_unlock
                &kp GRAVE &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &kp MINUS &kp EQUAL &kp BACKSPACE &kp KP_NUMLOCK &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS
                &kp F5 &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSLASH &kp HOME &kp PAGE_UP &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9
                &kp C_MUTE &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SINGLE_QUOTE &kp ENTER &kp END &kp PAGE_DOWN &kp KP_NUMBER_4 &kp KP_NUMBER_5 &kp KP_NUMBER_6 &kp KP_PLUS
                &soft_off &kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &kp SLASH &kp RIGHT_SHIFT &kp UP &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3
                &kp C_PLAY_PAUSE &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &kp SPACE &kp SPACE &kp RIGHT_ALT &kp RIGHT_GUI &kp RIGHT_CONTROL &kp LEFT &kp DOWN &kp RIGHT &kp KP_NUMBER_0 &kp KP_DOT &kp KP_ENTER 
            >;
        }; 

        bluetooth_layer {
            bindings = <
                &kp ESCAPE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &kp INSERT &kp DELETE &mo 1 &studio_unlock
                &kp GRAVE &kp NUMBER_1 &kp NUMBER_2 &kp NUMBER_3 &kp NUMBER_4 &kp NUMBER_5 &kp NUMBER_6 &kp NUMBER_7 &kp NUMBER_8 &kp NUMBER_9 &kp NUMBER_0 &kp MINUS &kp EQUAL &kp BACKSPACE &kp KP_NUMLOCK &bt BT_CLR &bt BT_CLR_ALL &bt BT_PRV
                &kp F5 &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp BACKSLASH &kp HOME &kp PAGE_UP &kp KP_NUMBER_7 &kp KP_NUMBER_8 &kp KP_NUMBER_9
                &kp C_MUTE &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SINGLE_QUOTE &kp ENTER &kp END &kp PAGE_DOWN &bt BT_SEL 3 &bt BT_SEL 4 &none &bt BT_NXT
                &soft_off &kp LEFT_SHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp PERIOD &kp SLASH &kp RIGHT_SHIFT &kp UP &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2
                &kp C_PLAY_PAUSE &kp LEFT_CONTROL &kp LEFT_GUI &kp LEFT_ALT &kp SPACE &kp SPACE &kp RIGHT_ALT &kp RIGHT_GUI &kp RIGHT_CONTROL &kp LEFT &kp DOWN &kp RIGHT &kp KP_NUMBER_0 &kp KP_DOT &kp KP_ENTER 
            >;
        }; 
    };
};