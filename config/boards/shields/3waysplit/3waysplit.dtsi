            , <&key_physical_attrs 150 100 1500  200       0     0     0>
            , <&key_physical_attrs 100 100 1675  200       0     0     0>
            , <&key_physical_attrs 100 100 1775  200       0     0     0>
            , <&key_physical_attrs 100 100 1975  200       0     0     0>
            , <&key_physical_attrs 100 100 2075  200       0     0     0>
            , <&key_physical_attrs 100 100 2275  200       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 175 100  125  300       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
